<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assistant Virtuel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .chat-window-transition {
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .message-animation {
            animation: messageAppear 0.3s cubic-bezier(0, 0, 0.2, 1);
        }
        @keyframes messageAppear {
            from { opacity: 0; transform: translateY(10px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-transparent">

    <!-- Launcher -->
    <div id="chat-launcher" class="fixed bottom-6 right-6 w-14 h-14 bg-black text-white rounded-full shadow-2xl cursor-pointer flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 z-[10000]">
        <svg id="launcher-icon" class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 1.657-1.343 3-3 3h-6c-1.657 0-3-1.343-3-3s1.343-3 3-3h6c1.657 0 3 1.343 3 3z" />
        </svg>
    </div>

    <!-- Chat Window -->
    <!-- FIX: Reduced height and adjusted bottom position to ensure it fits and doesn't cut off the top -->
    <div id="chat-window" class="fixed bottom-20 right-6 w-[350px] h-[500px] max-h-[80vh] glass rounded-[32px] shadow-[0_20px_50px_rgba(0,0,0,0.1)] flex flex-col overflow-hidden z-[9999] chat-window-transition opacity-0 pointer-events-none translate-y-10 scale-95">

        <!-- Header -->
        <div id="chat-header" class="px-6 py-4 flex items-center justify-between border-b border-gray-200/50 transition-colors duration-500">
            <div class="flex items-center gap-3">
                <div id="chat-avatar" class="w-10 h-10 bg-gray-100 text-black rounded-2xl flex items-center justify-center font-semibold text-sm border border-gray-200">??</div>
                <div class="overflow-hidden">
                    <h3 id="chat-header-name" class="text-sm font-semibold text-gray-900 truncate leading-tight">Chargement...</h3>
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                        <span class="text-[11px] text-gray-500 font-medium">En ligne</span>
                    </div>
                </div>
            </div>
            <button id="close-chat" class="p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Messages -->
        <div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-6 custom-scrollbar">
            <!-- Messages injected here -->
        </div>

        <!-- Reservation Form -->
        <div id="reservation-form" class="hidden p-6 bg-white border-t border-gray-100 space-y-4 message-animation">
            <h4 class="text-sm font-semibold text-gray-900 mb-3">Réserver une table/rendez-vous</h4>
            <div class="grid grid-cols-1 gap-3">
                <input type="text" id="res-name" placeholder="Votre nom complet" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                <input type="email" id="res-email" placeholder="Votre adresse email" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                <div class="flex gap-2">
                    <input type="date" id="res-date" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                    <input type="time" id="res-time" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                </div>
                <input type="number" id="res-guests" placeholder="Nombre de personnes" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                <input type="tel" id="res-phone" placeholder="Votre téléphone" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-black/5">
                <button id="confirm-res" class="w-full py-2 bg-black text-white rounded-xl text-xs font-semibold hover:bg-gray-800 transition-all">Confirmer la réservation</button>
                <button id="cancel-res" class="w-full py-2 text-gray-400 text-xs font-medium hover:text-gray-600 transition-all">Annuler</button>
            </div>
        </div>

        <!-- Input Area -->
        <div id="chat-input-container" class="p-6 pt-2">
            <div class="relative flex items-center gap-2">
                <input type="text" id="chat-input" placeholder="Écrivez votre message..."
                    class="w-full pl-4 pr-12 py-3 bg-gray-100 border-none rounded-2xl text-sm text-gray-800 placeholder-gray-400 focus:ring-2 focus:ring-black/5 transition-all outline-none">
                <button id="send-btn" class="absolute right-2 p-2 bg-black text-white rounded-xl hover:bg-gray-800 transition-all active:scale-90">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </button>
            </div>
            <div class="text-center mt-3">
                <span class="text-[10px] text-gray-400 font-medium uppercase tracking-widest">IA Haute Performance</span>
            </div>
        </div>

    <script type="module">
        const API_BASE = window.location.origin;
        const urlParams = new URLSearchParams(window.location.search);
        const clientId = urlParams.get('id') || 'client_default';

        let session = {
            id: sessionStorage.getItem('chat_session_id') || `sess_${Date.now()}`,
            isOpen: false,
            isLoading: false,
            history: JSON.parse(sessionStorage.getItem('chat_history') || '[]')
        };
        sessionStorage.setItem('chat_session_id', session.id);

        const dom = {
            launcher: document.getElementById('chat-launcher'),
            window: document.getElementById('chat-window'),
            messages: document.getElementById('chat-messages'),
            input: document.getElementById('chat-input'),
            send: document.getElementById('send-btn'),
            close: document.getElementById('close-chat'),
            headerName: document.getElementById('chat-header-name'),
            avatar: document.getElementById('chat-avatar'),
            header: document.getElementById('chat-header'),
            resForm: document.getElementById('reservation-form'),
            inputContainer: document.getElementById('chat-input-container'),
            confirmRes: document.getElementById('confirm-res'),
            cancelRes: document.getElementById('cancel-res')
        };

        async function initWidget() {
            try {
                const res = await fetch(`${API_BASE}/config/public?clientId=${clientId}`);
                const config = await res.json();
                dom.headerName.innerText = config.nom;
                dom.avatar.innerText = config.nom.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);

                if (config.colors) {
                    dom.header.style.backgroundColor = config.colors.primary;
                    dom.header.style.color = '#FFFFFF';
                    dom.send.style.backgroundColor = config.colors.primary;
                }

                addMessage(config.welcomeMsg, 'bot');

                const suggDiv = document.createElement('div');
                suggDiv.className = 'flex flex-wrap gap-2 mb-6';
                config.suggestions.forEach(text => {
                    const chip = document.createElement('div');
                    chip.className = 'px-3 py-1.5 bg-white border border-gray-200 text-gray-600 text-xs font-medium rounded-full cursor-pointer hover:border-black hover:text-black transition-all shadow-sm';
                    chip.innerText = text;
                    chip.onclick = () => { dom.input.value = text; sendMessage(); };
                    suggDiv.appendChild(chip);
                });
                dom.messages.appendChild(suggDiv);
            } catch (e) { console.error('Init error', e); }
        }

        function addMessage(text, sender) {
            const wrapper = document.createElement('div');
            wrapper.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'} message-animation`;
            const bubble = document.createElement('div');
            bubble.className = `max-w-[80%] px-4 py-2.5 rounded-2xl text-sm leading-relaxed ${
                sender === 'user'
                ? 'bg-black text-white rounded-tr-none shadow-md'
                : 'bg-white text-gray-800 border border-gray-200 rounded-tl-none shadow-sm'
            }`;
            bubble.innerText = text;
            wrapper.appendChild(bubble);
            dom.messages.appendChild(wrapper);
            scrollToBottom();
            session.history.push({text, sender});
            sessionStorage.setItem('chat_history', JSON.stringify(session.history.slice(-20)));
        }

        function scrollToBottom() {
            dom.messages.scrollTo({ top: dom.messages.scrollHeight, behavior: 'smooth' });
        }

        function showTypingIndicator() {
            const indicator = document.createElement('div');
            indicator.id = 'typing-indicator';
            indicator.className = 'flex justify-start message-animation';
            indicator.innerHTML = `
                <div class="bg-white border border-gray-200 px-4 py-3 rounded-2xl rounded-tl-none shadow-sm flex gap-1">
                    <span class="w-1.5 h-1.5 bg-gray-300 rounded-full animate-bounce"></span>
                    <span class="w-1.5 h-1.5 bg-gray-300 rounded-full animate-bounce [animation-delay:0.2s]"></span>
                    <span class="w-1.5 h-1.5 bg-gray-300 rounded-full animate-bounce [animation-delay:0.4s]"></span>
                </div
            `;
            dom.messages.appendChild(indicator);
            scrollToBottom();
            return indicator;
        }

        async function sendMessage() {
            const text = dom.input.value.trim();
            if (!text || session.isLoading) return;
            dom.input.value = '';
            addMessage(text, 'user');
            session.isLoading = true;
            dom.input.disabled = true;
            const indicator = showTypingIndicator();

            try {
                const res = await fetch(`${API_BASE}/chat`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ message: text, sessionId: session.id, clientId: clientId })
                });
                const data = await res.json();
                document.getElementById('typing-indicator')?.remove();
                addMessage(data.reply, 'bot');
                if (data.reply.toLowerCase().includes('réserver') || data.reply.toLowerCase().includes('réservation')) {
                    setTimeout(openReservationForm, 1000);
                }
            } catch (e) {
                document.getElementById('typing-indicator')?.remove();
                addMessage('Désolé, petit souci technique.', 'bot');
            } finally {
                session.isLoading = false;
                dom.input.disabled = false;
                scrollToBottom();
            }
        }

        function openReservationForm() {
            dom.inputContainer.classList.add('hidden');
            dom.resForm.classList.remove('hidden');
        }

        function closeReservationForm() {
            dom.resForm.classList.add('hidden');
            dom.inputContainer.classList.remove('hidden');
        }

        async function submitReservation() {
            const resData = {
                name: document.getElementById('res-name').value,
                email: document.getElementById('res-email').value,
                date: document.getElementById('res-date').value,
                time: document.getElementById('res-time').value,
                guests: document.getElementById('res-guests').value,
                phone: document.getElementById('res-phone').value,
                clientId: clientId
            };
            if (!resData.name || !resData.email || !resData.phone) {
                alert('SVP remplissez Nom, Email et Téléphone.');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/chat/reserve`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(resData)
                });
                if (res.ok) {
                    closeReservationForm();
                    addMessage(`Merci ${resData.name} ! Votre réservation a été enregistrée. Un email de confirmation vous a été envoyé.`, 'bot');
                }
            } catch (e) {
                alert('Erreur lors de la réservation.');
            }
        }

        dom.launcher.onclick = () => {
            session.isOpen = !session.isOpen;
            dom.window.classList.toggle('opacity-0', !session.isOpen);
            dom.window.classList.toggle('pointer-events-none', !session.isOpen);
            dom.window.classList.toggle('translate-y-10', !session.isOpen);
            dom.window.classList.toggle('scale-95', !session.isOpen);
            if (session.isOpen) dom.input.focus();
        };

        dom.close.onclick = (e) => {
            e.stopPropagation();
            session.isOpen = false;
            dom.window.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10', 'scale-95');
        };

        dom.send.onclick = sendMessage;
        dom.input.onkeydown = (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        };
        dom.confirmRes.onclick = submitReservation;
        dom.cancelRes.onclick = closeReservationForm;
        initWidget();
    </script>
</body>
</html>
